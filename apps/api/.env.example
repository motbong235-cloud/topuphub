NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://topuphub:topuphub@localhost:5432/topuphub?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-change-me-change-me-1234
SECRETS_KEY=change-me-change-me-change-me-5678
WEBHOOK_SECRET=change-me-change-me-change-me-9012
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000
START_WORKER=true

# —— Khmer TopUp (auto delivery) ——
TOPUP_PROVIDER=khmer_topup
KHMER_TOPUP_BASE_URL=https://khmer-topup.com/api/v1
KHMER_TOPUP_API_KEY=
KHMER_TOPUP_SECRET=

# —— Payment gateway ——
# auto | payway | khmer_system
PAYMENT_GATEWAY=auto
PAYMENT_SIMULATION=false

# Khmer System KHQR (recommended for Cambodia KHQR)
KHMER_SYSTEM_SECRET_KEY=
# ABA_API_KEY=   # alias of KHMER_SYSTEM_SECRET_KEY
KHMER_SYSTEM_TG_USER_ID=0
# KHMER_SYSTEM_PAY_URL=https://pay.khmer-system.com

# Official ABA PayWay (hosted checkout)
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
PAYWAY_ENV=sandbox

ADMIN_EMAIL=admin@topuphub.site
ADMIN_PASSWORD=change-this-password

# Private admin panel token (min 12 chars) — login at /th-console
ADMIN_TOKEN=change-me-admin-token-long
