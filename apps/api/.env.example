# ========= Core =========
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://topuphub:topuphub@localhost:5432/topuphub?schema=public
REDIS_URL=redis://localhost:6379
# Random 32+ chars each:  openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-1234
# Encrypts reseller API secrets in the database. NEVER change/lose it after go-live (secrets become unreadable).
SECRETS_KEY=change-me-change-me-change-me-5678
WEBHOOK_SECRET=change-me-change-me-change-me-9012
# Public URLs
APP_URL=http://localhost:3000          # web app (checkout page + PayWay return URLs)
API_URL=http://localhost:4000          # this API (PayWay pushback = API_URL/api/webhooks/payway)
CORS_ORIGIN=http://localhost:3000      # comma separated
START_WORKER=true                      # run BullMQ workers inside the web process (set false to run them separately)

# ========= Top-up provider =========
# mock | khmer_topup. Unset + NODE_ENV=development => mock.
TOPUP_PROVIDER=mock
KHMER_TOPUP_BASE_URL=https://khmer-topup.com/api/v1
KHMER_TOPUP_API_KEY=
KHMER_TOPUP_SECRET=                    # optional: adds X-Timestamp / X-Signature (HMAC-SHA256) headers if the provider needs them

# ========= PayWay (ABA) =========
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
PAYWAY_ENV=sandbox                     # sandbox | production
# Leave empty to use the documented hosts:
#   sandbox    https://checkout-sandbox.payway.com.kh
#   production https://checkout.payway.com.kh
PAYWAY_BASE_URL=
# true = skip PayWay and fake a successful payment (local testing only; refused when NODE_ENV=production)
PAYMENT_SIMULATION=true

# ========= Seed (npm run seed) =========
ADMIN_EMAIL=admin@topuphub.site
ADMIN_PASSWORD=change-this-password
